---
/**
 * BackLink Component - Navigation link with back arrow
 *
 * Features:
 * - Left arrow icon
 * - Hover animation
 * - Used for returning to parent pages
 */
interface Props {
  href: string;
  label?: string;
}

const { href, label = 'Back' } = Astro.props;
---

<a href={href} class="back-link">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    width="16"
    height="16"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="arrow-icon"
  >
    <path d="m12 19-7-7 7-7"></path>
    <path d="M19 12H5"></path>
  </svg>
  {label}
</a>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 2rem;
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .back-link:hover {
    color: var(--foreground);
    text-decoration: none;
  }

  .arrow-icon {
    transition: transform var(--transition-fast);
  }

  .back-link:hover .arrow-icon {
    transform: translateX(-2px);
  }
</style>
