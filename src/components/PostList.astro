---
/**
 * PostList Component - Display a list of blog posts
 *
 * Features:
 * - Accepts array of posts
 * - Displays title and formatted date
 * - Optional description display
 * - Responsive layout (stacked on mobile, inline on desktop)
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'writing'>[];
  showDescription?: boolean;
}

const { posts, showDescription = false } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => {
      const formattedDate = post.data.date.toLocaleDateString('en-US', {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
      });

      return (
        <li class="post-item">
          <a href={`/writing/${post.id}`} class="post-link">
            <span class="post-title">{post.data.title}</span>
            <time datetime={post.data.date.toISOString()} class="post-date">
              {formattedDate}
            </time>
          </a>
          {showDescription && post.data.description && (
            <p class="post-description">{post.data.description}</p>
          )}
        </li>
      );
    })
  }
</ul>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-item {
    margin-bottom: var(--spacing-md);
  }

  .post-item:last-child {
    margin-bottom: 0;
  }

  .post-link {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xs);
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 640px) {
    .post-link {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--spacing-md);
    }
  }

  .post-title {
    color: var(--color-text);
    transition: color var(--transition-fast);
  }

  .post-link:hover .post-title {
    color: var(--color-accent);
  }

  .post-date {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .post-description {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    margin-top: var(--spacing-xs);
    margin-bottom: 0;
  }
</style>
