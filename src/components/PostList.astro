---
/**
 * PostList Component - Display a list of blog posts
 *
 * Features:
 * - Accepts array of posts
 * - Displays title, date, and optional description
 * - Hover effect with background highlight
 * - Arrow icon animation on hover
 * - Tag display support
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'writing'>[];
  showDescription?: boolean;
}

const { posts, showDescription = false } = Astro.props;
---

<ul class="post-list">
  {
    posts.map((post) => {
      const formattedDate = post.data.date.toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
      });

      return (
        <li>
          <a href={`/writing/${post.id}`} class="post-card">
            <div class="post-content">
              <div class="post-header">
                <h3 class="post-title">{post.data.title}</h3>
                <svg
                  class="arrow-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M7 7h10v10" />
                  <path d="M7 17 17 7" />
                </svg>
              </div>
              {showDescription && post.data.description && (
                <p class="post-description">{post.data.description}</p>
              )}
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map((tag: string) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
            <time datetime={post.data.date.toISOString()} class="post-date">
              {formattedDate}
            </time>
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-list > li {
    margin: 0;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
    margin: 0 -1rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition: background-color 300ms ease;
  }

  @media (min-width: 640px) {
    .post-card {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
    }
  }

  .post-card:hover {
    background-color: rgba(255, 255, 255, 0.05);
    text-decoration: none;
  }

  :global(.light) .post-card:hover {
    background-color: rgba(0, 0, 0, 0.03);
  }

  .post-content {
    flex: 1;
  }

  .post-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .post-title {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--foreground);
    margin: 0;
    line-height: 1.4;
    transition: color var(--transition-fast);
  }

  .post-card:hover .post-title {
    color: var(--primary);
  }

  .arrow-icon {
    flex-shrink: 0;
    color: var(--muted-foreground);
    opacity: 0;
    transform: translate(4px, -4px);
    transition:
      opacity 300ms ease,
      transform 300ms ease,
      color 300ms ease;
  }

  .post-card:hover .arrow-icon {
    opacity: 1;
    transform: translate(0, 0);
    color: var(--primary);
  }

  .post-description {
    margin-top: 0.25rem;
    margin-bottom: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--muted-foreground);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .tag {
    padding: 0.125rem 0.625rem;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--muted-foreground);
    border: 1px solid var(--border);
    border-radius: 9999px;
  }

  .post-date {
    flex-shrink: 0;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .post-date {
      font-size: var(--text-sm);
    }
  }

  /* Stagger animation for list items */
  .post-list > li:nth-child(1) .post-card {
    animation: fade-in-up var(--duration-slow) var(--ease-out) both;
    animation-delay: 0ms;
  }
  .post-list > li:nth-child(2) .post-card {
    animation: fade-in-up var(--duration-slow) var(--ease-out) both;
    animation-delay: 50ms;
  }
  .post-list > li:nth-child(3) .post-card {
    animation: fade-in-up var(--duration-slow) var(--ease-out) both;
    animation-delay: 100ms;
  }
  .post-list > li:nth-child(4) .post-card {
    animation: fade-in-up var(--duration-slow) var(--ease-out) both;
    animation-delay: 150ms;
  }
  .post-list > li:nth-child(5) .post-card {
    animation: fade-in-up var(--duration-slow) var(--ease-out) both;
    animation-delay: 200ms;
  }
  .post-list > li:nth-child(n + 6) .post-card {
    animation: fade-in-up var(--duration-slow) var(--ease-out) both;
    animation-delay: 250ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .post-list > li .post-card {
      animation: none;
    }
  }
</style>
