---
/**
 * ThemeToggle Component - Toggle between light and dark themes
 *
 * Features:
 * - Sun/Moon icons (swap visibility based on current theme)
 * - Click handler toggles between light/dark mode
 * - Persists preference to localStorage
 * - Default: dark mode
 */
---

<button id="theme-toggle" type="button" aria-label="Toggle theme" class="theme-toggle">
  <svg
    class="sun-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <line x1="12" y1="1" x2="12" y2="3"></line>
    <line x1="12" y1="21" x2="12" y2="23"></line>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
    <line x1="1" y1="12" x2="3" y2="12"></line>
    <line x1="21" y1="12" x2="23" y2="12"></line>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
  </svg>
  <svg
    class="moon-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<script>
  // Use event delegation so handler survives View Transitions DOM swaps
  document.addEventListener('click', (e) => {
    const toggle = (e.target as HTMLElement).closest('#theme-toggle');
    if (toggle) {
      const isLight = document.documentElement.classList.toggle('light');
      document.documentElement.classList.toggle('dark', !isLight);
      localStorage.setItem('theme', isLight ? 'light' : 'dark');
    }
  });
</script>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    background: transparent;
    border: none;
    border-radius: var(--radius);
    color: var(--muted-foreground);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .theme-toggle:hover {
    color: var(--foreground);
  }

  /* Show sun in dark mode (to switch to light), moon in light mode (to switch to dark) */
  .sun-icon {
    display: block;
  }

  .moon-icon {
    display: none;
  }

  :global(.light) .sun-icon {
    display: none;
  }

  :global(.light) .moon-icon {
    display: block;
  }
</style>
