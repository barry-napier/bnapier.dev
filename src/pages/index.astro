---
/**
 * Homepage - Personal introduction and featured content
 *
 * Content:
 * - Personal introduction paragraph
 * - Featured posts section (filtered by featured: true)
 * - Connect section with social links
 * - Inline navigation to /writing, /projects, /now
 */
import Base from '@layouts/Base.astro';
import PostList from '@/components/PostList.astro';
import { getCollection } from 'astro:content';

// Get featured posts, sorted by date (newest first)
const featuredPosts = (
  await getCollection('writing', ({ data }) => data.featured && !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base>
  <!-- Intro Section -->
  <section class="intro">
    <p class="intro-text">
      I'm a software engineer passionate about building great products and exploring the
      intersection of technology and human experience. I write about
      <span class="highlight">software development</span>,
      <span class="highlight">AI</span>, and the lessons learned along the way.
    </p>

    <nav class="inline-nav">
      <a href="/writing">Writing</a>
      <a href="/projects">Projects</a>
      <a href="/now">Now</a>
    </nav>
  </section>

  <!-- Featured Writing Section -->
  {
    featuredPosts.length > 0 && (
      <section class="featured">
        <h2 class="section-title">Featured Writing</h2>
        <PostList posts={featuredPosts} showDescription />
        <a href="/writing" class="view-all">
          View all posts
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </section>
    )
  }

  <!-- Connect Section -->
  <section class="connect">
    <h2 class="section-title">Connect</h2>
    <p class="connect-text">
      Find me on
      <a href="https://github.com/bnapier" target="_blank" rel="noopener noreferrer">GitHub</a>,
      <a href="https://twitter.com/bnapier" target="_blank" rel="noopener noreferrer">Twitter</a>,
      and
      <a href="https://linkedin.com/in/barrynapier" target="_blank" rel="noopener noreferrer"
        >LinkedIn</a
      >. Subscribe via <a href="/rss.xml">RSS</a>.
    </p>
  </section>
</Base>

<style>
  .intro {
    margin-bottom: 4rem;
  }

  @media (min-width: 640px) {
    .intro {
      margin-bottom: 6rem;
    }
  }

  .intro-text {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--muted-foreground);
    margin-bottom: var(--spacing-lg);
  }

  .highlight {
    color: var(--foreground);
  }

  .inline-nav {
    display: flex;
    gap: var(--spacing-lg);
  }

  .inline-nav a {
    color: var(--foreground);
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--transition-fast);
  }

  .inline-nav a:hover {
    text-decoration-color: var(--foreground);
  }

  .featured {
    margin-bottom: 4rem;
  }

  @media (min-width: 640px) {
    .featured {
      margin-bottom: 6rem;
    }
  }

  .section-title {
    margin-bottom: var(--spacing-lg);
    margin-top: 0;
    font-size: var(--text-sm);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted-foreground);
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: var(--spacing-lg);
    padding: 0.5rem 0;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--muted-foreground);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .view-all:hover {
    color: var(--foreground);
    text-decoration: none;
  }

  .view-all svg {
    transition: transform var(--transition-fast);
  }

  .view-all:hover svg {
    transform: translateX(2px);
  }

  .connect {
    margin-bottom: var(--spacing-xl);
  }

  .connect-text {
    color: var(--muted-foreground);
    line-height: 1.75;
  }

  .connect-text a {
    display: inline-block;
    padding: 0.125rem 0;
    color: var(--foreground);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--transition-fast);
  }

  .connect-text a:hover {
    text-decoration-color: var(--foreground);
  }
</style>
