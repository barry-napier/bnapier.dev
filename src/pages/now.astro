---
/**
 * Now Page - What I'm currently up to
 *
 * Features:
 * - Last updated date
 * - Current work section
 * - Learning section
 * - Life section
 * - Link to nownownow.com explanation
 */
import Base from '@layouts/Base.astro';

const lastUpdated = 'January 2026';
---

<Base title="Now" description="What I'm currently working on and focused on.">
  <header class="page-header">
    <h1 class="page-title">Now</h1>
    <p class="last-updated">Last updated: {lastUpdated}</p>
  </header>

  <section class="now-section">
    <h2 class="section-title">Work</h2>
    <p class="section-text">
      Principal AI Context Engineer at Aflac. My days split between building enterprise applications
      with AI tooling, helping other engineers get more productive with these tools, and trying to
      keep up with how fast everything's moving.
    </p>
  </section>

  <section class="now-section">
    <h2 class="section-title">Learning</h2>
    <ul class="learning-list">
      <li>Context engineering</li>
      <li>Agentic systems</li>
      <li>Model Context Protocol (MCP)</li>
    </ul>
  </section>

  <section class="now-section">
    <h2 class="section-title">Life</h2>
    <p class="section-text">Based in Belfast, Northern Ireland. Husband and dad of three.</p>
  </section>

  <section class="now-footer">
    <p class="footer-text">
      This is a <a
        href="https://nownownow.com/about"
        target="_blank"
        rel="noopener noreferrer"
        class="footer-link">now page</a
      >. It's a snapshot of what I'm focused on at this point in my life.
    </p>
  </section>
</Base>

<style>
  .page-header {
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--foreground);
    margin-bottom: var(--spacing-sm);
  }

  @media (min-width: 640px) {
    .page-title {
      font-size: var(--text-4xl);
    }
  }

  .last-updated {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    margin: 0;
  }

  .now-section {
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--foreground);
    margin-bottom: var(--spacing-md);
    margin-top: 0;
  }

  .section-text {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--muted-foreground);
    margin: 0;
  }

  .learning-list {
    padding-left: var(--spacing-lg);
    margin: 0;
    color: var(--muted-foreground);
    line-height: 1.75;
  }

  .learning-list li {
    margin-bottom: var(--spacing-sm);
  }

  .learning-list li:last-child {
    margin-bottom: 0;
  }

  .now-footer {
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .footer-text {
    font-size: var(--text-sm);
    color: var(--muted-foreground);
    margin: 0;
  }

  .footer-link {
    color: var(--foreground);
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 4px;
    transition: text-decoration-color var(--transition-fast);
  }

  .footer-link:hover {
    text-decoration-color: var(--foreground);
  }
</style>
