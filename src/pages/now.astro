---
/**
 * Now Page - What I'm currently up to
 *
 * Static page with:
 * - Last updated date
 * - Current work section
 * - Learning section
 * - Life section
 * - Link to nownownow.com explanation
 */
import Base from '@layouts/Base.astro';
import BackLink from '@/components/BackLink.astro';

const lastUpdated = 'January 2026';
---

<Base title="Now" description="What I'm currently working on and focused on.">
  <BackLink href="/" label="Home" />

  <header class="page-header">
    <h1>Now</h1>
    <p class="last-updated">Last updated: {lastUpdated}</p>
  </header>

  <section class="now-section">
    <h2>Work</h2>
    <p>
      Building software and exploring the possibilities of AI-assisted development.
      Focused on creating tools and systems that help developers be more productive.
    </p>
  </section>

  <section class="now-section">
    <h2>Learning</h2>
    <ul>
      <li>Diving deeper into AI/ML fundamentals and their practical applications</li>
      <li>Exploring modern web frameworks and their patterns</li>
      <li>Understanding context engineering and prompt design</li>
    </ul>
  </section>

  <section class="now-section">
    <h2>Life</h2>
    <p>
      Based in the UK. Enjoying time with family, reading, and the occasional
      side project that may or may not see the light of day.
    </p>
  </section>

  <section class="now-section now-explanation">
    <p>
      This is a <a href="https://nownownow.com/about" target="_blank" rel="noopener noreferrer">now page</a>.
      It's a snapshot of what I'm focused on at this point in my life.
    </p>
  </section>
</Base>

<style>
  .page-header {
    margin-bottom: var(--spacing-xl);
  }

  .page-header h1 {
    margin-bottom: var(--spacing-sm);
  }

  .last-updated {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .now-section {
    margin-bottom: var(--spacing-xl);
  }

  .now-section h2 {
    margin-bottom: var(--spacing-md);
  }

  .now-section p {
    color: var(--color-text-muted);
  }

  .now-section ul {
    color: var(--color-text-muted);
    padding-left: var(--spacing-lg);
    margin: 0;
  }

  .now-section li {
    margin-bottom: var(--spacing-sm);
  }

  .now-section li:last-child {
    margin-bottom: 0;
  }

  .now-explanation {
    padding-top: var(--spacing-lg);
    border-top: 1px solid var(--color-border);
  }

  .now-explanation p {
    font-size: var(--text-sm);
  }

  .now-explanation a {
    color: var(--color-text);
  }

  .now-explanation a:hover {
    color: var(--color-accent);
  }
</style>
