---
/**
 * Projects Page - List of projects and work
 *
 * Features:
 * - Project cards with hover effects
 * - Tech stack tags
 * - External link indicator
 */
import Base from '@layouts/Base.astro';

interface Project {
  name: string;
  description: string;
  tech: string[];
  link?: string;
  github?: string;
}

const projects: Project[] = [
  {
    name: 'bnapier.dev',
    description:
      'This personal website. Built with Astro, Tailwind CSS, and the Geist design system.',
    tech: ['Astro', 'Tailwind', 'TypeScript'],
    github: 'https://github.com/barry-napier/bnapier.dev',
  },
  {
    name: 'Nag',
    description:
      "AI-powered todo companion. A chat-based app with memory — like a competent friend who lives in your terminal and won't let you forget things.",
    tech: ['Next.js', 'React', 'TypeScript', 'Tailwind', 'Claude API'],
    link: 'https://nag.bnapier.dev',
  },
];
---

<Base title="Projects" description="Things I've built and worked on.">
  <header class="page-header">
    <h1 class="page-title">Projects</h1>
    <p class="page-description">Things I've built and worked on.</p>
  </header>

  <div class="projects-grid">
    {
      projects.map((project) => (
        <a
          href={project.github || project.link || '#'}
          target="_blank"
          rel="noopener noreferrer"
          class="project-card"
        >
          <div class="project-header">
            <h3 class="project-name">{project.name}</h3>
            <svg
              class="arrow-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M7 7h10v10" />
              <path d="M7 17 17 7" />
            </svg>
          </div>
          <p class="project-description">{project.description}</p>
          <div class="project-tech">
            {project.tech.map((t) => (
              <span class="tech-tag">{t}</span>
            ))}
          </div>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .page-header {
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--foreground);
    margin-bottom: var(--spacing-md);
  }

  @media (min-width: 640px) {
    .page-title {
      font-size: var(--text-4xl);
    }
  }

  .page-description {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--muted-foreground);
    margin: 0;
  }

  .projects-grid {
    display: grid;
    gap: 1rem;
    margin-top: 3rem;
  }

  .project-card {
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background-color: var(--card);
    text-decoration: none;
    transition:
      border-color 200ms ease,
      background-color 200ms ease;
  }

  .project-card:hover {
    border-color: var(--muted-foreground);
    text-decoration: none;
  }

  .project-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-name {
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--foreground);
    margin: 0;
  }

  .arrow-icon {
    flex-shrink: 0;
    color: var(--muted-foreground);
    opacity: 0;
    transform: translate(2px, -2px);
    transition:
      opacity 200ms ease,
      transform 200ms ease;
  }

  .project-card:hover .arrow-icon {
    opacity: 1;
    transform: translate(0, 0);
  }

  .project-description {
    margin-top: 0.75rem;
    margin-bottom: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--muted-foreground);
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .tech-tag {
    padding: 0.125rem 0.625rem;
    font-size: var(--text-xs);
    color: var(--muted-foreground);
    border: 1px solid var(--border);
    border-radius: 9999px;
  }
</style>
