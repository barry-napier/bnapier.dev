---
/**
 * Writing Index Page - List of all blog posts
 *
 * Features:
 * - Page title and description
 * - Full post list sorted by date (newest first)
 * - Filters out drafts
 */
import Base from '@layouts/Base.astro';
import PostList from '@/components/PostList.astro';
import { getCollection } from 'astro:content';

// Get all published posts, sorted by date (newest first)
const posts = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base
  title="Writing"
  description="Thoughts on software development, AI, and the lessons learned along the way."
>
  <header class="page-header">
    <h1 class="page-title">Writing</h1>
    <p class="page-description">
      Thoughts on software development, AI, and the lessons learned along the way.
    </p>
  </header>

  <div class="posts-container">
    {
      posts.length > 0 ? (
        <PostList posts={posts} showDescription />
      ) : (
        <p class="no-posts">No posts yet. Check back soon!</p>
      )
    }
  </div>
</Base>

<style>
  .page-header {
    margin-bottom: 3rem;
  }

  .page-title {
    font-size: var(--text-3xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--foreground);
    margin-bottom: var(--spacing-md);
  }

  @media (min-width: 640px) {
    .page-title {
      font-size: var(--text-4xl);
    }
  }

  .page-description {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--muted-foreground);
    margin: 0;
  }

  .posts-container {
    margin-top: 3rem;
  }

  .no-posts {
    color: var(--muted-foreground);
  }
</style>
